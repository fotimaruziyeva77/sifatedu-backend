# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
APP_URL=http://localhost
API_DOCS_ENABLED=true
LOG_FORMAT=plain
LOG_LEVEL=INFO

# --- DB / Redis / S3 ---
# Docker Compose ichida DATABASE_URL, REDIS_URL, CELERY_BROKER_URL, S3_ENDPOINT,
# S3_ACCESS_KEY va S3_SECRET_KEY avtomatik beriladi (root .env'dan).
# Compose'siz ishga tushirilganda shu yerda yozing:
# DATABASE_URL=postgres://sifatedu:change-me@localhost:15433/sifatedu
# REDIS_URL=redis://localhost:6379/0
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET_PRIVATE=sifat-private
S3_BUCKET_PUBLIC=sifat-public
MAX_VIDEO_SIZE_MB=2048
# Brauzer faylni shu o'lchamdagi qismlarga bo'lib yuboradi.
VIDEO_PART_SIZE_MB=16
HLS_SIGNED_URL_TTL_SEC=7200
# Segment shifrlash kalitlari shu sir bilan shifrlanadi. Bo'sh bo'lsa DJANGO_SECRET_KEY
# ishlatiladi; uni o'zgartirsangiz, eski videolar ochilmaydi.
VIDEO_KEY_SECRET=
# Brauzer S3'ga to'g'ridan-to'g'ri murojaat qiladi: bucket CORS'iga qo'shiladigan manzillar.
S3_CORS_ORIGINS=http://localhost

# --- SMS (Eskiz) ---
SMS_DRY_RUN=true
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Ommaviy xabarda SMS narxini taxminlash uchun (bitta SMS, so'm).
SMS_PRICE_UZS=100

# --- To'lov (Click) ---
# Click kabinetidan olinadi. Bo'sh bo'lsa, saytda sotib olish tugmasi ko'rinmaydi.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Fiskal chek uchun STIR. FISCAL_DRY_RUN=true bo'lsa chek yuborilmaydi (local).
CLICK_MERCHANT_TIN=
FISCAL_DRY_RUN=true

# --- Ijtimoiy kirish (bepul) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# "Authorized JavaScript origins" ga sayt manzilini qo'shing (local: http://localhost).
GOOGLE_CLIENT_ID=
# Telegram bot nomi (@siz): botga havolalar (t.me/...) va saytdagi Telegram kirish tugmasi.
# Kirish tugmasi ishlashi uchun @BotFather'da /setdomain qiling.
TELEGRAM_BOT_USERNAME=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
TELEGRAM_ALERTS_CHAT_ID=
# Kunlik hisobot (ixtiyoriy guruh). Direktor va adminlarga Telegram'i ulangan bo'lsa baribir boradi.
TELEGRAM_REPORTS_CHAT_ID=
# Kunlik hisobot soati (Toshkent vaqti).
DAILY_REPORT_HOUR=21
# Bot webhook'i uchun maxfiy kalit (tasodifiy qator): `manage.py telegram_webhook set`.
TELEGRAM_WEBHOOK_SECRET=

# --- AI maslahatchi (Google Gemini API) ---
# Kalit: aistudio.google.com → Get API key; loyihada billing (pullik tarif) yoqilsin — bepul
# tarifda yozishmalar Google mahsulotlarini yaxshilashga ishlatilishi mumkin.
# Bo'sh bo'lsa va DRY_RUN=false — saytda chat ko'rinmaydi, botda oddiy rejim.
GEMINI_API_KEY=
# Model va uning narxi ($ / 1M token, budjet hisobi uchun) birga o'zgartiriladi:
#   gemini-3.8-flash — 1.50 / 7.50 (standart; 2026 yil oxirigacha 0.75 / 3.75)
#   gemini-3.1-pro-preview — 2 / 12 (kuchliroq, sinov holatida)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PRICE_INPUT=1.5
GEMINI_PRICE_OUTPUT=7.5
# Fikrlash chuqurligi: minimal | low | medium | high (chat uchun low — tez va arzon)
GEMINI_THINKING_LEVEL=low
# true — Gemini chaqirilmaydi, oddiy "test rejimi" javob beradi (local va E2E).
ASSISTANT_DRY_RUN=false

# --- Monitoring ---
SENTRY_DSN=

# --- Faqat local: admin avtomatik yaratiladi (ENSURE_SUPERUSER=1 bo'lsa) ---
DJANGO_SUPERUSER_PHONE=
DJANGO_SUPERUSER_PASSWORD=
