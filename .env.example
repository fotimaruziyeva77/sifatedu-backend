# Docker Compose uchun (faqat infratuzilma). Ilova sozlamalari backend/.env va frontend/.env'da.

# Sayt manzili: http://localhost (port band bo'lsa, o'zgartiring)
HTTP_BIND=127.0.0.1
HTTP_PORT=80

POSTGRES_DB=sifatedu
POSTGRES_USER=sifatedu
POSTGRES_PASSWORD=change-me
# Hostdan DB'ga ulanish uchun (faqat local)
POSTGRES_PORT=15433

# S3 storage (SeaweedFS): local'da va serverda. Backend shu kalitlar bilan ulanadi.
# Production'da qiymatlarni infra/deploy/make-env.sh yaratadi; S3_PORT va S3_UI_PORT — faqat local.
S3_ACCESS_KEY=sifatedu
S3_SECRET_KEY=change-me-too
S3_PORT=9000
S3_UI_PORT=8888

# --- Frontend build (brauzerga ketadigan qiymatlar image yig'ilganda yoziladi) ---
# Saytning ommaviy manzili (SEO, canonical, Open Graph)
APP_URL=http://localhost
# Ochiq fayllar manzili: kurs muqovalari, rasmlar (CSP ham shunga ruxsat beradi)
S3_PUBLIC_URL=http://localhost:9000/sifat-public
# Brauzerdagi xatolar uchun Sentry DSN (ixtiyoriy)
SENTRY_DSN_FRONTEND=
SENTRY_ENVIRONMENT=production
